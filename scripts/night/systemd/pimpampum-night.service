[Unit]
Description=Pim Pam Pum night run (scripts/night/night.sh)

[Service]
Type=oneshot
Environment=PATH=/run/current-system/sw/bin:/etc/profiles/per-user/%u/bin:%h/.nix-profile/bin
# Always the night script as it is on origin/main, whatever the checkout holds.
ExecStart=/run/current-system/sw/bin/bash -c 'git -C %h/pimpampum fetch -q origin main && git -C %h/pimpampum show origin/main:scripts/night/night.sh > %t/pimpampum-night.sh && exec nix develop %h/pimpampum --command bash %t/pimpampum-night.sh'
TimeoutStartSec=8h
Nice=5
